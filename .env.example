# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
TAILOR_MODEL=claude-sonnet-4-6
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ---- Google (Gmail + Calendar OAuth2) ----
# Path to the OAuth client secrets downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the generated OAuth token is cached after first consent.
GOOGLE_TOKEN_FILE=token.json

# ---- Storage ----
DATABASE_URL=sqlite:///job_agent.db

# ---- Safety rails ----
# Master kill switch. When true, no scraping, drafting, or automation runs.
PAUSE_ALL=false
# Hard cap on applications prepared per day.
MAX_APPLICATIONS_PER_DAY=20
# Random delay bounds (seconds) inserted between browser actions.
MIN_ACTION_DELAY=30
MAX_ACTION_DELAY=120

# ---- Candidate ----
CANDIDATE_PROFILE_FILE=candidate_profile.yaml
MASTER_RESUME_FILE=master_resume.md

# ---- Scraping ----
JOB_SEARCH_KEYWORDS=Data Scientist
JOB_SEARCH_LOCATION=Coimbatore
HEADLESS=true
